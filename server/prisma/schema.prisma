datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String         @id @default(cuid())
  name               String
  email              String         @unique
  password           String
  phone              String?
  role               String         @default("RIDER") // RIDER, HOST, ADMIN
  vehicleModel       String?
  vehicleNumber      String?
  batteryCapacityKwh Float?
  avatar             String?
  isVerified         Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  hostProfile        HostProfile?
  bookings           Booking[]
  reviews            Review[]
  notifications      Notification[]
  complaints         Complaint[]

  @@index([email])
  @@index([role])
}

model HostProfile {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String?
  bio          String?
  address      String
  city         String
  state        String
  pincode      String
  idProofType  String?
  isVerified   Boolean            @default(false)
  payoutUpiId  String?
  rating       Float              @default(5.0)
  totalReviews Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  locations    ChargingLocation[]
}

model ChargingLocation {
  id                 String              @id @default(cuid())
  hostId             String
  host               HostProfile         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title              String
  description        String
  address            String
  landmark           String?
  city               String
  state              String
  pincode            String
  latitude           Float
  longitude          Float
  category           String              // RESIDENTIAL, CAFE, SHOP, OFFICE, PARKING
  images             String              // JSON string of array
  amenities          String?             // JSON string of array
  isVerified         Boolean             @default(false)
  verificationStatus String              @default("PENDING") // PENDING, APPROVED, REJECTED
  verificationNotes  String?
  isActive           Boolean             @default(true)
  rating             Float               @default(5.0)
  totalReviews       Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  equipments         ChargingEquipment[]
  slots              AvailabilitySlot[]
  bookings           Booking[]
  reviews            Review[]

  @@index([city])
  @@index([verificationStatus])
  @@index([isActive])
}

model ChargingEquipment {
  id                 String           @id @default(cuid())
  locationId         String
  location           ChargingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name               String
  equipmentType      String           // SOCKET_16A, WALLBOX_TYPE2, BHARAT_AC001, FAST_DC
  connectorType      String           // PIN_3_16A, TYPE_2, GB_T, PROPRIETARY
  powerKw            Float
  voltageV           Int              @default(230)
  currentA           Int              @default(16)
  isDedicatedEvse    Boolean          @default(false) // distinguishes ordinary electrical socket from dedicated EVSE
  hasEarthProtection Boolean          @default(true)
  supportedVehicles  String           // JSON string of array
  safetyFeatures     String?          // JSON string of array
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  bookings           Booking[]
}

model AvailabilitySlot {
  id           String           @id @default(cuid())
  locationId   String
  location     ChargingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek    String           // ALL, Monday, Tuesday, etc.
  startTime    String           // e.g. "06:00"
  endTime      String           // e.g. "23:00"
  pricePerHour Float
  isAvailable  Boolean          @default(true)
  createdAt    DateTime         @default(now())
}

model Booking {
  id                 String             @id @default(cuid())
  bookingNumber      String             @unique
  riderId            String
  rider              User               @relation(fields: [riderId], references: [id], onDelete: Cascade)
  locationId         String
  location           ChargingLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  equipmentId        String?
  equipment          ChargingEquipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  bookingDate        String             // "2026-11-06"
  startTime          String             // "10:00"
  endTime            String             // "12:00"
  durationHours      Float
  ratePerHour        Float
  subtotal           Float
  platformFee        Float
  totalAmount        Float
  hostEarnings       Float
  status             String             @default("PENDING") // PENDING, CONFIRMED, REJECTED, CANCELLED, COMPLETED
  cancellationReason String?
  vehicleModel       String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payment            Payment?
  review             Review?
  complaints         Complaint[]

  @@index([riderId])
  @@index([locationId])
  @@index([status])
}

model Payment {
  id                String   @id @default(cuid())
  bookingId         String   @unique
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionId     String   @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Float
  currency          String   @default("INR")
  status            String   @default("PAID") // PAID, FAILED, REFUNDED
  paymentMethod     String   @default("RAZORPAY_TEST")
  isSimulated       Boolean  @default(true)
  paidAt            DateTime @default(now())

  @@index([transactionId])
}

model Review {
  id         String           @id @default(cuid())
  bookingId  String           @unique
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  riderId    String
  rider      User             @relation(fields: [riderId], references: [id], onDelete: Cascade)
  locationId String
  location   ChargingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  rating     Int              // 1 to 5
  comment    String
  hostReply  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([locationId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   // BOOKING_CREATED, BOOKING_CONFIRMED, BOOKING_CANCELLED, VERIFICATION_APPROVED, PAYMENT_RECEIVED, SYSTEM
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Complaint {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  subject     String
  description String
  status      String    @default("OPEN") // OPEN, IN_REVIEW, RESOLVED
  adminNotes  String?
  resolution  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

